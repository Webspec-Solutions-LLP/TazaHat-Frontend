# Backend API. Server-side only: the browser never sees this address (all API calls run on the Next.js server).
# UI work does not need the backend code: use the live API. (Own backend running locally: "http://localhost:8000".)
API_BASE_URL="https://api.taza.webspec.in"

# Google Maps Platform. The map in the browser needs the NEXT_PUBLIC key (restrict it to your site's referrers).
# Address lookup (pin -> pincode) runs on the server with GOOGLE_MAPS_API_KEY (restrict that one by server IP).
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY="AIzaSyBZwWYqlIAqxeVwCwMc_456auE01_w7VKo"
GOOGLE_MAPS_API_KEY="AIzaSyBZwWYqlIAqxeVwCwMc_456auE01_w7VKo"

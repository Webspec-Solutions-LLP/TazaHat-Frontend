# Non-secret settings of the TazaHat website deployment (read by the Jenkinsfile, TENANT=tazahat). One KEY=value per line, no quotes.
# The backend repository has the matching deploy/tenants/<tenant>.env (API container name, secrets folder).
TENANT=tazahat
BRAND_NAME=TazaHat
IMAGE_NAME=tazahat-frontend
CONTAINER_NAME=tazahat-frontend-service
HOST_WEB_PORT=4006
MEMORY_LIMIT=512m
# the website's addresses (one certificate covers all). test-site.machranga.co.in is the old placeholder address that has always been served by this container.
VIRTUAL_HOSTS=taza.webspec.in,test-site.machranga.co.in
LETSENCRYPT_HOSTS=taza.webspec.in,test-site.machranga.co.in
LETSENCRYPT_EMAIL=debnathtapash56@gmail.com
# this tenant's API container on proxy-net (server side only) and its folder in Jenkins' home with the google-maps-key file
API_BASE_URL=http://tazahat-api-service:8000
ENV_DIR=/var/jenkins_home/tazahat
